@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization

<PageTitle>ExamBlaze — Home</PageTitle>

<div class="home-page-wrapper page-container">

    <div class="home-orb home-orb-1"></div>
    <div class="home-orb home-orb-2"></div>

    
    <div class="home-hero animate-fade-in-up">
        <div class="home-hero-icon animate-float">⚡</div>
        <h3>ExamBlaze</h3>
        <p>Online examination platform for students and administrators. Track, test, and triumph.</p>
    </div>

    
    <AuthorizeView Context="authContext">
        <Authorized>

            <AuthorizeView Roles="Admin" Context="adminContext">
                <div class="home-action-section animate-fade-in-up delay-2">
                    <div class="home-welcome-badge">Admin Portal</div>
                    <p class="home-welcome-text">Welcome back, Administrator. Manage exams, students, and results from your dashboard.</p>
                    <div class="home-action-grid single">
                        <MudButton Href="/admin/dashboard"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Dashboard"
                                   Class="btn-start-exam home-action-btn">
                            Go to Dashboard
                        </MudButton>
                    </div>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="Student" Context="studentContext">
                <div class="home-action-section animate-fade-in-up delay-2">
                    <div class="home-welcome-badge">Student Portal</div>
                    <p class="home-welcome-text">Welcome back! Your exams are ready. Good luck today.</p>
                    <div class="home-action-grid single">
                        <MudButton Href="/student/exams"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.PlayCircle"
                                   Class="btn-start-exam home-action-btn">
                            View Available Exams
                        </MudButton>
                    </div>
                </div>
            </AuthorizeView>

        </Authorized>
        <NotAuthorized>

            <div class="home-action-section animate-fade-in-up delay-2">
                <p class="home-welcome-text">Get started by logging in or creating a new account.</p>
                <div class="home-action-grid double">
                    <MudButton Href="Account/Login"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Class="btn-start-exam home-action-btn">
                        Sign In
                    </MudButton>
                    <MudButton Href="Account/Register"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Class="home-action-btn-outline">
                        Register
                    </MudButton>
                </div>
            </div>

        </NotAuthorized>
    </AuthorizeView>

    <div class="home-features animate-fade-in-up delay-4">
        <div class="home-feature-card delay-1 animate-scale-in">
            <div class="home-feature-icon">📋</div>
            <div class="home-feature-title">Timed Exams</div>
            <div class="home-feature-desc">Auto-submitted with real-time countdown timers</div>
        </div>
        <div class="home-feature-card delay-2 animate-scale-in">
            <div class="home-feature-icon">📊</div>
            <div class="home-feature-title">Live Results</div>
            <div class="home-feature-desc">Instant scoring and detailed performance analytics</div>
        </div>
        <div class="home-feature-card delay-3 animate-scale-in">
            <div class="home-feature-icon">🔒</div>
            <div class="home-feature-title">Secure Access</div>
            <div class="home-feature-desc">Role-based authentication for admins and students</div>
        </div>
    </div>

</div>

<style>
    .home-page-wrapper {
        min-height: calc(100vh - 64px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 24px 60px;
        gap: 32px;
        position: relative;
        overflow: hidden;
    }

    /* Background orbs */
    .home-orb {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(70px);
        z-index: 0;
    }
    .home-orb-1 {
        width: 380px; height: 380px;
        background: rgba(255, 87, 34, 0.10);
        top: -100px; right: -80px;
    }
    .home-orb-2 {
        width: 280px; height: 280px;
        background: rgba(255, 202, 40, 0.08);
        bottom: -60px; left: -60px;
    }

    /* Hero overrides */
    .home-hero {
        text-align: center;
        max-width: 560px;
        width: 100%;
        position: relative;
        z-index: 1;
    }

    .home-hero-icon {
        font-size: 3.2rem;
        display: block;
        margin-bottom: 16px;
        filter: drop-shadow(0 6px 16px rgba(255, 87, 34, 0.4));
    }

    /* Action section */
    .home-action-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        width: 100%;
        max-width: 480px;
        position: relative;
        z-index: 1;
    }

    .home-welcome-badge {
        background: linear-gradient(135deg, #ff8c5a, #ff5722);
        color: #fff;
        padding: 5px 18px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        box-shadow: 0 4px 14px rgba(255, 87, 34, 0.3);
    }

    .home-welcome-text {
        font-size: 0.95rem;
        color: #7a5040;
        text-align: center;
        font-weight: 400;
        line-height: 1.6;
        margin: 0;
    }

    .home-action-grid {
        width: 100%;
        display: flex;
        gap: 14px;
    }

    .home-action-grid.single {
        justify-content: center;
    }

    .home-action-grid.double {
        justify-content: center;
        flex-wrap: wrap;
    }

    .home-action-btn {
        min-width: 180px !important;
    }

    /* Outlined / Register button */
    .home-action-btn-outline {
        min-width: 160px !important;
        border-radius: 16px !important;
        border: 2px solid rgba(255, 87, 34, 0.55) !important;
        color: #e64019 !important;
        background: #f5ede8 !important;
        font-family: 'Syne', sans-serif !important;
        font-size: 0.95rem !important;
        font-weight: 700 !important;
        text-transform: none !important;
        letter-spacing: 0.3px !important;
        padding: 12px 28px !important;
        box-shadow: 5px 5px 14px rgba(190,130,110,0.3), -5px -5px 12px rgba(255,255,255,0.75) !important;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    }

    .home-action-btn-outline:hover {
        background: rgba(255, 87, 34, 0.07) !important;
        border-color: #ff5722 !important;
        transform: translateY(-3px) scale(1.02) !important;
        box-shadow: 8px 8px 22px rgba(190,130,110,0.35), -8px -8px 18px rgba(255,255,255,0.82) !important;
    }

    /* Feature cards */
    .home-features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        width: 100%;
        max-width: 680px;
        position: relative;
        z-index: 1;
    }

    .home-feature-card {
        background: #f5ede8;
        border-radius: 20px;
        padding: 22px 18px;
        text-align: center;
        box-shadow: 6px 6px 16px rgba(190,130,110,0.32), -6px -6px 14px rgba(255,255,255,0.82);
        transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        cursor: default;
    }

    .home-feature-card:hover {
        transform: translateY(-6px);
        box-shadow: 10px 10px 26px rgba(190,130,110,0.38), -10px -10px 22px rgba(255,255,255,0.88);
    }

    .home-feature-icon {
        font-size: 1.8rem;
        margin-bottom: 10px;
        display: block;
    }

    .home-feature-title {
        font-family: 'Syne', sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
        color: #3a1f15;
        margin-bottom: 6px;
    }

    .home-feature-desc {
        font-size: 0.78rem;
        color: #9b6252;
        line-height: 1.5;
        font-weight: 400;
    }

    @@media (max-width: 600px) {
        .home-features {
            grid-template-columns: 1fr;
            max-width: 320px;
        }

        .home-action-grid.double {
            flex-direction: column;
            align-items: center;
        }

        .home-action-btn,
        .home-action-btn-outline {
            width: 100% !important;
        }
    }
</style>

