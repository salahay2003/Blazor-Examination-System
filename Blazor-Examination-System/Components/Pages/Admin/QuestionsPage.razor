@page "/admin/exams/{ExamId:int}/questions"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IQuestionManager QuestionManager
@inject IExamManager ExamManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Questions</PageTitle>

<MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Class="mb-4">← Back to Exams</MudButton>

@if (_exam != null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Exam: @_exam.Title | Subject: @_exam.Subject?.Name | Total Marks: @_exam.TotalMarks
    </MudAlert>
}

<MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenAddDialog" Class="mb-4">Add Question</MudButton>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="_questions" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>Question</MudTh>
            <MudTh>Marks</MudTh>
            <MudTh>Choices</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@context.OrderIndex</MudTd>
            <MudTd DataLabel="Question">
                @if (context.Text.Length > 80)
                {
                    @(context.Text[..80] + "...")
                }
                else
                {
                    @context.Text
                }
            </MudTd>
            <MudTd DataLabel="Marks">@context.Marks</MudTd>
            <MudTd DataLabel="Choices">@context.Choices.Count</MudTd>
            <MudTd DataLabel="Actions">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditDialog(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="() => OpenDeleteDialog(context)" />
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            <MudTr>
                <MudTd colspan="5">
                    <MudSimpleTable Bordered="true" Dense="true">
                        <tbody>
                            @foreach (var choice in context.Choices.OrderBy(c => c.OrderIndex))
                            {
                                <tr>
                                    <td>@choice.OrderIndex</td>
                                    <td>@choice.Text</td>
                                    <td>
                                        @if (choice.IsCorrect)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Correct</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Wrong</MudChip>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudTd>
            </MudTr>
        </ChildRowContent>
    </MudTable>
}

@code {
    [Parameter] public int ExamId { get; set; }

    private Exam? _exam;
    private List<Question> _questions = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _exam = await ExamManager.GetByIdWithDetailsAsync(ExamId);
            _questions = await QuestionManager.GetByExamIdAsync(ExamId);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/exams");
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters { ["Question"] = null, ["ExamId"] = ExamId };
        var dialog = await DialogService.ShowAsync<QuestionDialog>("Add Question", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            try
            {
                var data = (QuestionDialogResultData)result.Data!;
                await QuestionManager.CreateWithChoicesAsync(data.Question, data.Choices);
                Snackbar.Add("Question added!", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(Question question)
    {
        var parameters = new DialogParameters { ["Question"] = question, ["ExamId"] = ExamId };
        var dialog = await DialogService.ShowAsync<QuestionDialog>("Edit Question", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            try
            {
                var data = (QuestionDialogResultData)result.Data!;
                await QuestionManager.UpdateWithChoicesAsync(question.Id, data.Question, data.Choices);
                Snackbar.Add("Question updated!", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenDeleteDialog(Question question)
    {
        var parameters = new DialogParameters { ["ContentText"] = "Are you sure you want to delete this question?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Question", parameters);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            try
            {
                await QuestionManager.DeleteAsync(question.Id);
                Snackbar.Add("Question deleted!", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }
}
