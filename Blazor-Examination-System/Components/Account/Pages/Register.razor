@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Blazor_Examination_System.Data

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Register — ExamBlaze</PageTitle>

<div class="login-page-wrapper">

    <div class="login-orb login-orb-1"></div>
    <div class="login-orb login-orb-2"></div>
    <div class="login-orb login-orb-3"></div>

    <div class="login-card animate-fade-in-up">

        <div class="login-brand-panel">
            <div class="login-brand-content">
                <div class="login-brand-icon animate-float">🚀</div>
                <h1 class="login-brand-title">Join ExamBlaze</h1>
                <p class="login-brand-sub">Create your account and start your examination journey today.</p>

                <div class="login-brand-features">
                    <div class="login-feature-item delay-1 animate-fade-in-up">
                        <span class="login-feature-dot"></span>
                        Free student account
                    </div>
                    <div class="login-feature-item delay-2 animate-fade-in-up">
                        <span class="login-feature-dot"></span>
                        Access all available exams
                    </div>
                    <div class="login-feature-item delay-3 animate-fade-in-up">
                        <span class="login-feature-dot"></span>
                        Track your progress &amp; results
                    </div>
                </div>

                <div class="reg-already-have delay-4 animate-fade-in-up">
                    Already have an account?
                    <MudLink Href="Account/Login" Class="reg-signin-link">Sign in →</MudLink>
                </div>
            </div>
        </div>

        <div class="login-form-panel">
            <div class="login-form-inner">

                <div class="login-form-header animate-fade-in-up">
                    <h2 class="login-form-title">Create account</h2>
                    <p class="login-form-subtitle">Fill in your details to get started</p>
                </div>

                <StatusMessage Message="@Message" />

                <EditForm Model="Input" asp-route-returnUrl="@ReturnUrl" method="post" OnValidSubmit="RegisterUser" FormName="register">
                    <DataAnnotationsValidator />

                    <div class="login-fields delay-1 animate-fade-in-up">

                        <div class="login-field-group">
                            <MudStaticTextField
                                For="@(() => Input.Email)"
                                @bind-Value="Input.Email"
                                Label="Email Address"
                                Placeholder="name@example.com"
                                Variant="Variant.Outlined"
                                Class="login-field"
                                UserAttributes="@(new() { { "autocomplete", "username" }, { "aria-required", "true" } })" />
                        </div>

                        <div class="login-field-group">
                            <MudStaticTextField
                                For="@(() => Input.Password)"
                                @bind-Value="Input.Password"
                                Label="Password"
                                InputType="InputType.Password"
                                Placeholder="Min. 6 characters"
                                Variant="Variant.Outlined"
                                Class="login-field"
                                UserAttributes="@(new() { { "autocomplete", "new-password" }, { "aria-required", "true" } })" />
                        </div>

                        <div class="login-field-group">
                            <MudStaticTextField
                                For="@(() => Input.ConfirmPassword)"
                                @bind-Value="Input.ConfirmPassword"
                                Label="Confirm Password"
                                InputType="InputType.Password"
                                Placeholder="Repeat your password"
                                Variant="Variant.Outlined"
                                Class="login-field"
                                UserAttributes="@(new() { { "autocomplete", "new-password" }, { "aria-required", "true" } })" />
                        </div>

                        <div class="reg-role-note">
                            <span class="reg-role-icon">🎓</span>
                            You will be registered as <strong>Student</strong> by default.
                        </div>

                        <MudStaticButton
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            FullWidth="true"
                            FormAction="FormAction.Submit"
                            Class="btn-start-exam login-submit-btn">
                            Create Account →
                        </MudStaticButton>

                        <div class="login-divider">
                            <span class="login-divider-line"></span>
                            <span class="login-divider-text">or register with</span>
                            <span class="login-divider-line"></span>
                        </div>

                        <div class="reg-external">
                            <ExternalLoginPicker />
                        </div>

                    </div>
                </EditForm>

            </div>
        </div>

    </div>
</div>

